# --- Database (Neon / Vercel Postgres) ---
# Se assente, l'app usa automaticamente i dati seed inclusi (fallback, nessun crash).
# DATABASE_URL="postgresql://utente:password@host/db?sslmode=require"
DATABASE_URL=""

# --- AI via opencode (https://opencode.ai) ---
# Di default l'app avvia da sola un `opencode serve` locale (serve il comando
# `opencode` nel PATH, gia' autenticato con `opencode providers`).
# SL_OPENCODE_URL="http://127.0.0.1:4096"   # usa un server opencode gia' avviato
# SL_OPENCODE_MODEL="opencode-go/muse-spark-1.3-contributor"
# SL_OPENCODE_API="auto"                     # auto | v2 | v1
# SL_OPENCODE_TIMEOUT_MS="120000"
# SL_OPENCODE="off"                          # spegne l'AI: solo analisi offline

# --- Sito (usato dal feed RSS e dai link assoluti) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cron ingest (Vercel) ---
# Se CRON_SECRET e' impostato, /api/cron/ingest + /api/sync/* richiedono
# l'header `Authorization: Bearer <CRON_SECRET>`. Se assente: aperti solo fuori
# produzione, in produzione 401 (fail-closed).
# CRON_SECRET=""

# --- Corpus (solo testi reali di default) ---
# Di default l'app serve SOLO testi reali: seed curati + data/reali/ + 2 atti
# di riferimento. Niente schede di prova, niente testi inventati.
# CORPUS_SINTETICO=1 attiva il corpus sintetico legacy (atti dimostrativi +
# varianti "Variante N"): solo opt-in per dev/test, mai in produzione.
# CORPUS_SINTETICO="1"
#
# --- Corpus sintetico legacy (solo con CORPUS_SINTETICO=1) ---
# Dimensione totale del corpus sintetico (min 87, max 20000, default 5000).
# CORPUS_TOTALE="5000"
# Seme deterministico per le varianti sintetiche (default "simple-law-v1").
# CORPUS_SEED="simple-law-v1"

# --- Normattiva Open Data ---
# Base URL delle API Open Data (bff-opendata v1). Configurabile senza deploy.
# NORMATTIVA_API_BASE="https://api.normattiva.it/t/normattiva.api/bff-opendata/v1"
