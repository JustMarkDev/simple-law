    "sync:storico": "tsx scripts/sync-storico.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "effect": "3.22.2",
    "motion": "13.4.4",
    "next": "15.5.26",
