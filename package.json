{
  "name": "simple-law-italia",
  "version": "0.1.0",
  "private": true,
  "description": "SimpleLaw Italia - Dati politici italiani + semplificatore di leggi con AI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
