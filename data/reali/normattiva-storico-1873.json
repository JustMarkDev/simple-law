      "chiave": "/eli/id/1868/08/06/068U4530/sg",
      "titolo": "REGIO DECRETO 6 agosto 1868, n. 4530",
      "tipo": "regio.decreto",
      "numero": "4530",
      "dataEmanazione": "1868-08-06",
