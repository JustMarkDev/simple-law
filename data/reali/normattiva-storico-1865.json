      "stato": "in_vigore",
      "sintesi": "Che approva il Regolamento per l'esecuzione della Legge sul contenzioso amministrativo. (065U2361)",
      "fonti": {
        "normattiva": "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:regio.decreto:1865-06-25;2361",
        "gazzetta": "https://www.gazzettaufficiale.it/eli/id/1865/07/22/065U2361/sg",
