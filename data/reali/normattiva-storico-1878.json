    {
      "chiave": "/eli/id/1875/12/19/7501177R/sg",
      "titolo": "REGIO DECRETO 19 dicembre 1875, n. 1177",
      "tipo": "regio.decreto",
      "numero": "1177",
      "dataEmanazione": "1875-12-19",
      "nir": "urn:nir:stato:regio.decreto:1875-12-19;1177",
      "eli": "/eli/id/1875/12/19/7501177R/sg",
      "stato": "in_vigore",
      "sintesi": "Che approva la banca cooperativa degli operai in Bisceglie. (7501177R)",
      "fonti": {
        "normattiva": "https://www.normattiva.it/uri-res/N2Ls?urn:nir:stato:regio.decreto:1875-12-19;1177",
        "gazzetta": "https://www.gazzettaufficiale.it/eli/id/1876/01/15/7501177R/sg",
        "governo": "https://www.governo.it/it/archivio-consiglio-dei-ministri"
      },
      "dataGU": "1876-01-15",
      "numeroGU": "11",
      "codiceRedazionale": "7501177R",
      "articoloDataFineVigenza": "99999999",
      "testo": "VITTORIO EMANUELE II PER GRAZIA DI DIO E PER VOLONT&Agrave; DELLA NAZIONE RE D'ITALIA Visti gli atti costitutivi e lo statuto della societ&agrave; per le operazioni di credito popolare, di risparmio ed altre, stabilita in Bisceglie, provincia di Bari, col nome di Banca cooperativa degli operai in Bisceglie, colla durata di 10 anni decorrendi dalla data del presente decreto e col capitale nominale di lire 25,000 diviso in n. 1,000 azioni da lire 25 ciascuna; Visto il titolo VII, libro I, del codice di commercio; Visti i reali decreti del 30 dicembre 1865, n. 2727, e del 5 settembre 1869, n. 5256; Sentito il consiglio di Stato; Sulla proposta del ministro d'agricoltura, industria e commercio; Abbiamo decretato e decretiamo: Art. 1 &Egrave; autorizzata la societ&agrave; cooperativa di credito, anonima per azioni nominative, denominatasi Banca cooperativa degli operai in Bisceglie, sedente in Bisceglie ed ivi costituitasi coll'atto pubblico del 31 marzo 1875, rogato Assunto Ferorelli al n. 19 di repertorio, ed &egrave; approvato il suo statuto quale &egrave; inserto all'atto pubblico di deposito del 22 novembre 1875, rogato pure in Bisceglie dallo stesso notaio ai n. 70 e 39 di repertorio."
    },
