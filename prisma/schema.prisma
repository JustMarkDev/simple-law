// SimpleLaw Italia - schema dati
// Provider: PostgreSQL (Neon / Vercel Postgres).
// L'app funziona anche SENZA database: in quel caso usa il fallback su dati seed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Atto normativo italiano (legge, decreto-legge, decreto legislativo, ...).
model Law {
  eli            String   @id // identificativo ELI, es. /eli/id/2026/07/27/26G00155/sg
  nir            String // URN NIR, es. urn:nir:stato:decreto.legge:2026-07-27;133
  tipo           String // decreto.legge | legge | decreto.legislativo | ...
  numero         String
  dataEmanazione DateTime
  titolo         String
  sintesi        String
  stato          String // in_vigore | in_esame | abrogato | ...
  gulpease       Float?
  fonti          Json?
  /// Dati arricchiti dal seed: air, attuativi, testo, fiducia, omnibus, dimostrativo.
  extra          Json?
  /// Impronta SHA-256 del testo integrale (lo shard conserva il testo, mai `Law`).
  testoHash      String?
  /// Lunghezza in caratteri del testo integrale (per filtro/soglie senza leggere lo shard).
  lunghezzaTesto Int?
  // Full-text dedicato (migrazione dedicata, opzionale):
  // - estensione `pg_trgm` per ILIKE/trigram;
  // - colonna generata `tsv tsvector GENERATED ALWAYS AS (to_tsvector('italian', titolo || ' ' || sintesi)) STORED`;
  // - indice GIN `@@index([tsv], type: Gin)`.
  // Il testo integrale resta SOLO su `data/corpus/shard-*.jsonl.gz`, mai in `Law`.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipo])
  @@index([dataEmanazione])
  @@index([tipo, dataEmanazione])
  @@index([nir])
  // Ordina per titolo senza full-scan; la ricerca full-text resta ILIKE
  // (pg_trgm/tsvector in migrazione dedicata, non in questo change minimale).
  @@index([titolo])
  // Filtra per stato senza full-scan.
  @@index([stato])
  // Scala 100GB: copre filtro stato + ordinamento cronologico senza full-scan.
  @@index([stato, dataEmanazione])
  // Scala 100GB: copre filtro/sort `minGulpease` / `gulpease_desc`.
  @@index([gulpease])
  // Scala 100GB: paginazione a cursore (dataEmanazione, eli) senza OFFSET profondo.
  @@index([dataEmanazione, eli])
  // Opzionale (migrazione dedicata): @@index([tsv], type: Gin) dopo `CREATE EXTENSION pg_trgm`.
}

/// Ministro / titolare di dicastero.
model Minister {
  slug       String   @id
  nome       String
  dicastero  String
  partito    String?
  competenze String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([dicastero])
}

/// Tracciamento delle esecuzioni di ingest (cron).
model IngestRun {
  id         String    @id @default(cuid())
  source     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // ok | error | skipped
  detail     String?

  @@index([source, startedAt])
}
